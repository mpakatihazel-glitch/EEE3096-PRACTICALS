/* USER CODE BEGIN Header */
/**
  @file           : main.c
  @brief          : Running light with timer interrupt skeleton
  */
/* USER CODE END Header */

/* Includes ------------------------------------------------------------------*/
#include "main.h"
#include "stm32f0xx.h"
#include <stdint.h>

/* Private variables ---------------------------------------------------------*/
TIM_HandleTypeDef htim16;

/* USER CODE BEGIN PV */
volatile uint8_t timer_event = 0;    // Flag set by ISR and polled in main loop
volatile uint8_t current_led = 0;    // Track current LED index (0..7)
volatile int8_t direction = 1;       // Track direction (+1 for forward, -1 for backward)

// LED port and pin arrays for easy indexing (PB0 to PB7)
GPIO_TypeDef* led_ports[8] = {GPIOB, GPIOB, GPIOB, GPIOB, GPIOB, GPIOB, GPIOB, GPIOB};
uint16_t led_pins[8] = {
    GPIO_PIN_0, GPIO_PIN_1, GPIO_PIN_2, GPIO_PIN_3,
    GPIO_PIN_4, GPIO_PIN_5, GPIO_PIN_6, GPIO_PIN_7
};
/* USER CODE END PV */

/* Private function prototypes -----------------------------------------------*/
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_TIM16_Init(void);
void TIM16_IRQHandler(void);
void TIM16_17_IRQHandler(void);
void turn_off_all_leds(void);
void update_led_pattern(void);

/* USER CODE BEGIN 0 */
void turn_off_all_leds(void)
{
    /* Iterate through the LED arrays and turn off all LEDs */
    for (uint8_t i = 0; i < 8; i++) {
        HAL_GPIO_WritePin(led_ports[i], led_pins[i], GPIO_PIN_RESET);
    }
}

void update_led_pattern(void)
{
    // 1. Turn off all LEDs
    turn_off_all_leds();

    // 2. Turn on the current active LED
    HAL_GPIO_WritePin(led_ports[current_led], led_pins[current_led], GPIO_PIN_SET);

    // 3. Move current_led index based on direction
    current_led += direction;

    // 4. Handle direction reversal at edges (0 and 7)
    if (current_led == 7) {
        direction = -1;
    } else if (current_led == 0) {
        direction = 1;
    }
}
/* USER CODE END 0 */

/**
  @brief  The application entry point.
  @retval int
*/
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_TIM16_Init();

    /* USER CODE BEGIN 2 */
    // Ensure all LEDs are off at start
    turn_off_all_leds();

    // Start the timer interrupt
    HAL_TIM_Base_Start_IT(&htim16);
    /* USER CODE END 2 */

    while (1)
    {
        /* USER CODE BEGIN WHILE */
        /* Check if timer_event flag is set by ISR */
        if (timer_event == 1) {
            timer_event = 0;          // Clear flag
            update_led_pattern();      // Advance running light
        }
        /* USER CODE END WHILE */
    }
}

/**
  @brief System Clock Configuration (HSI 8 MHz)
*/
void SystemClock_Config(void)
{
    LL_FLASH_SetLatency(LL_FLASH_LATENCY_0);
    while(LL_FLASH_GetLatency() != LL_FLASH_LATENCY_0) {}

    LL_RCC_HSI_Enable();
    while(LL_RCC_HSI_IsReady() != 1) {}

    LL_RCC_HSI_SetCalibTrimming(16);
    LL_RCC_SetAHBPrescaler(LL_RCC_SYSCLK_DIV_1);
    LL_RCC_SetAPB1Prescaler(LL_RCC_APB1_DIV_1);
    LL_RCC_SetSysClkSource(LL_RCC_SYS_CLKSOURCE_HSI);
    while(LL_RCC_GetSysClkSource() != LL_RCC_SYS_CLKSOURCE_STATUS_HSI) {}

    LL_SetSystemCoreClock(8000000);

    if (HAL_InitTick(TICK_INT_PRIORITY) != HAL_OK) {
        Error_Handler();
    }
}

/**
  @brief TIM16 Initialization – 1-second interrupt frequency
*/
static void MX_TIM16_Init(void)
{
    /* Enable Peripheral Clock for TIM16 */
    __HAL_RCC_TIM16_CLK_ENABLE();

    htim16.Instance = TIM16;
    htim16.Init.Prescaler = 7999;
    htim16.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim16.Init.Period = 999;
    htim16.Init.ClockDivision = TIM_CLOCKDIVISION_DIV1;
    htim16.Init.RepetitionCounter = 0;
    htim16.Init.AutoReloadPreload = TIM_AUTORELOAD_PRELOAD_ENABLE;

    if (HAL_TIM_Base_Init(&htim16) != HAL_OK) {
        Error_Handler();
    }

#ifdef TIM16_17_IRQn
    NVIC_EnableIRQ(TIM16_17_IRQn);
#else
    NVIC_EnableIRQ(TIM16_IRQn);
#endif
}

/**
  @brief GPIO Initialization – PB0..PB7 as outputs for LEDs
*/
static void MX_GPIO_Init(void)
{
    /* Enable GPIOB Clock */
    __HAL_RCC_GPIOB_CLK_ENABLE();

    GPIO_InitTypeDef GPIO_InitStruct = {0};
    GPIO_InitStruct.Mode = GPIO_MODE_OUTPUT_PP;
    GPIO_InitStruct.Pull = GPIO_NOPULL;
    GPIO_InitStruct.Speed = GPIO_SPEED_FREQ_LOW;

    // Configure PB0 to PB7
    for (uint8_t i = 0; i < 8; i++) {
        GPIO_InitStruct.Pin = led_pins[i];
        HAL_GPIO_Init(led_ports[i], &GPIO_InitStruct);
    }
}

/**
  @brief Primary TIM16 interrupt handler
*/
void TIM16_IRQHandler(void)
{
    HAL_TIM_IRQHandler(&htim16);   // Clears internal update flag
    timer_event = 1;               // Set signal flag for main loop
}

/**
  @brief Secondary ISR Alias (STM32F0 hardware shares vector between TIM16 & TIM17)
*/
void TIM16_17_IRQHandler(void)
{
    TIM16_IRQHandler();
}

/**
  @brief Error handler
*/
void Error_Handler(void)
{
    __disable_irq();
    while (1) {}
}
