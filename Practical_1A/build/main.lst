  20:Core/Src/main.c **** 
  21:Core/Src/main.c **** // LED arrays
  22:Core/Src/main.c **** GPIO_TypeDef* led_ports[8] = {GPIOB, GPIOB, GPIOB, GPIOB, GPIOB, GPIOB, GPIOB, GPIOB};
  23:Core/Src/main.c **** uint16_t led_pins[8] = {
  24:Core/Src/main.c ****     GPIO_PIN_0, GPIO_PIN_1, GPIO_PIN_2, GPIO_PIN_3,
  25:Core/Src/main.c ****     GPIO_PIN_4, GPIO_PIN_5, GPIO_PIN_6, GPIO_PIN_7
  26:Core/Src/main.c **** };
  27:Core/Src/main.c **** 
  28:Core/Src/main.c **** // Standard debounce delay in ms
  29:Core/Src/main.c **** #define DEBOUNCE_MS 50
  30:Core/Src/main.c **** uint32_t last_button_press_time = 0;
  31:Core/Src/main.c **** 
  32:Core/Src/main.c **** // Speed state: 0 = slow (1s), 1 = fast (0.5s)
  33:Core/Src/main.c **** uint8_t speed_state = 0;
