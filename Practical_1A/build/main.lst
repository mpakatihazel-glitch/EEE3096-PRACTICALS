  51:Core/Src/main.c **** void turn_off_all_leds(void)
  52:Core/Src/main.c **** {
  53:Core/Src/main.c ****     // Iterate through the LED array and set all pins to RESET
  54:Core/Src/main.c ****     for (uint8_t i = 0; i < 8; i++) {
  55:Core/Src/main.c ****         HAL_GPIO_WritePin(led_ports[i], led_pins[i], GPIO_PIN_RESET);
  56:Core/Src/main.c ****     }
  57:Core/Src/main.c **** }
  58:Core/Src/main.c **** 
  59:Core/Src/main.c **** void update_led_pattern(void)
  60:Core/Src/main.c **** {
  61:Core/Src/main.c ****     // 1. Turn off all LEDs
  62:Core/Src/main.c ****     turn_off_all_leds();
  63:Core/Src/main.c **** 
  64:Core/Src/main.c ****     // 2. Turn on the specific LED at index 'current_led'
  65:Core/Src/main.c ****     HAL_GPIO_WritePin(led_ports[current_led], led_pins[current_led], GPIO_PIN_SET);
  66:Core/Src/main.c **** 
  67:Core/Src/main.c ****     // 3. Increment or decrement 'current_led' based on 'direction'
  68:Core/Src/main.c ****     current_led += direction;
  69:Core/Src/main.c **** 
  70:Core/Src/main.c ****     // 4. Reverse 'direction' when reaching the ends (0 or 7)
  71:Core/Src/main.c ****     if (current_led == 7) {
  72:Core/Src/main.c ****         direction = -1;
  73:Core/Src/main.c ****     } else if (current_led == 0) {
  74:Core/Src/main.c ****         direction = 1;
  75:Core/Src/main.c ****     }
  76:Core/Src/main.c **** }
  77:Core/Src/main.c **** 
  78:Core/Src/main.c **** void change_timer_period(uint32_t new_period_ms)
  79:Core/Src/main.c **** {
  80:Core/Src/main.c ****     // Calculate new ARR value (1000 Hz timer tick rate with PSC = 7999)
  81:Core/Src/main.c ****     uint32_t new_arr = new_period_ms - 1;
  82:Core/Src/main.c **** 
  83:Core/Src/main.c ****     // Update the TIM16 ARR register directly
  84:Core/Src/main.c ****     htim16.Instance->ARR = new_arr;
  85:Core/Src/main.c **** 
  86:Core/Src/main.c ****     // Reset the TIM16 CNT register to 0
  87:Core/Src/main.c ****     htim16.Instance->CNT = 0;
  88:Core/Src/main.c **** 
  89:Core/Src/main.c ****     // Store the new ARR value for reference
  90:Core/Src/main.c ****     current_arr = new_arr;
ARM GAS  C:\Users\HAZELM~1\AppData\Local\Temp\ccBIb6Fk.s 			page 3


  91:Core/Src/main.c **** }
  92:Core/Src/main.c **** 
  93:Core/Src/main.c **** void handle_button_press(void)
  94:Core/Src/main.c **** {
  95:Core/Src/main.c ****     // Get the current system tick using HAL_GetTick()
  96:Core/Src/main.c ****     uint32_t current_time = HAL_GetTick();
  97:Core/Src/main.c **** 
  98:Core/Src/main.c ****     // Read the PA0 button state (Active Low)
  99:Core/Src/main.c ****     if (HAL_GPIO_ReadPin(GPIOA, GPIO_PIN_0) == GPIO_PIN_RESET) {
 100:Core/Src/main.c ****         // Check time elapsed since last press against DEBOUNCE_MS
 101:Core/Src/main.c ****         if ((current_time - last_button_press_time) >= DEBOUNCE_MS) {
 102:Core/Src/main.c ****             // 1. Update last_button_press_time
 103:Core/Src/main.c ****             last_button_press_time = current_time;
 104:Core/Src/main.c **** 
 105:Core/Src/main.c ****             // 2. Toggle speed_state between 0 and 1
 106:Core/Src/main.c ****             speed_state = !speed_state;
 107:Core/Src/main.c **** 
 108:Core/Src/main.c ****             // 3. Call change_timer_period() with 500ms or 1000ms
 109:Core/Src/main.c ****             if (speed_state == 1) {
 110:Core/Src/main.c ****                 change_timer_period(500);   // Fast speed (0.5s)
 111:Core/Src/main.c ****             } else {
 112:Core/Src/main.c ****                 change_timer_period(1000);  // Slow speed (1.0s)
 113:Core/Src/main.c ****             }
 114:Core/Src/main.c ****         }
 115:Core/Src/main.c ****     }
 116:Core/Src/main.c **** }
