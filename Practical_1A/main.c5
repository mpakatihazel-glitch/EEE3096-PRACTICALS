#include "main.h"

/* ---------- Function prototypes ---------- */
static void GPIO_Init(void);
static void ADC_Init(void);
static void write_led_byte(uint8_t pattern);

int main(void)
{
    HAL_Init(); // still fine to call - only sets up SysTick/core clocks
    GPIO_Init();
    ADC_Init();

    /* TODO: Start continuous conversion using ADC1 control register */
    /* Start continuous conversion using ADC1 control register */
        ADC1->CR |= ADC_CR_ADSTART;
    while (1)
    {
        /* everything happens in the ISR */
    }
}

/* ---------- GPIO Configuration ---------- */
static void GPIO_Init(void)
{
    /* TODO: Enable clocks for GPIOA and GPIOB */
	/* Enable clocks for GPIOA and GPIOB */
	    RCC->AHBENR |= (RCC_AHBENR_GPIOAEN | RCC_AHBENR_GPIOBEN);
    /* TODO: Configure PA5 as Analog mode (11) for ADC_IN5 */
	    /* Configure PA5 as Analog mode (11) for ADC_IN5 */
	        GPIOA->MODER |= (3U << (5 * 2)); // Sets both bits for pin 5 to 1

    /* TODO: Configure PB0-PB7 as General purpose outputs (01) and clear ODR initially */
	        /* Configure PB0-PB7 as General purpose outputs (01) and clear ODR initially */
	            GPIOB->MODER &= ~(0xFFFFU);      // Clear mode bits for PB0-PB7
	            GPIOB->MODER |= 0x5555U;         // Set to 01 (output) for PB0-PB7
	            GPIOB->ODR &= ~(0xFFU);          // Clear output data register
}

/* ---------- ADC Configuration ---------- */
static void ADC_Init(void)
{
	/* Enable APB2 clock for ADC1 */
	    RCC->APB2ENR |= RCC_APB2ENR_ADC1EN;

	    /* Ensure ADC is disabled, then run calibration */
	    if ((ADC1->CR & ADC_CR_ADEN) != 0) {
	        ADC1->CR |= ADC_CR_ADDIS;
	        while ((ADC1->CR & ADC_CR_ADEN) != 0); // Wait until disabled
	    }
	    ADC1->CR |= ADC_CR_ADCAL;
	    while ((ADC1->CR & ADC_CR_ADCAL) != 0);    // Wait for calibration to finish

	    /* Select channel 5 (PA5) and configure sampling time */
	    ADC1->CHSELR |= ADC_CHSELR_CHSEL5;

	    /* Configure 12-bit resolution, right alignment, and continuous conversion mode */
	    // Note: 12-bit and right-alignment are 0 by default in CFGR1
	    ADC1->CFGR1 |= ADC_CFGR1_CONT;

	    /* Enable end-of-conversion interrupt and configure NVIC priorities */
	    ADC1->IER |= ADC_IER_EOCIE;
	    NVIC_EnableIRQ(ADC1_COMP_IRQn);

	    /* Enable the ADC and wait for the ADRDY flag */
	    ADC1->ISR |= ADC_ISR_ADRDY;               // Clear the ready flag
	    ADC1->CR |= ADC_CR_ADEN;                  // Enable ADC
	    while ((ADC1->ISR & ADC_ISR_ADRDY) == 0); // Wait until ready
}

/* ---------- Interrupt Service Routine ---------- */
void ADC1_COMP_IRQHandler(void)
{
    if (ADC1->ISR & ADC_ISR_EOC)
    {
    	/* Read the raw 12-bit ADC value from the data register (DR) */
    	        uint32_t adc_val = ADC1->DR;

    	        /* Scale the raw value proportionally to a number of LEDs (0 - 8) */
    	        // Multiply by 9 and divide by 4096 (which is bitshifting right by 12)
    	        uint8_t leds_to_light = (adc_val * 9) >> 12;

    	        /* Build the bar-graph bit pattern using bitwise shifting */
    	        // E.g., if leds_to_light = 3: (1 << 3) - 1 = 8 - 1 = 7 (which is 00000111 in binary)
    	        uint8_t output_pattern = (1 << leds_to_light) - 1;

    	        /* Drive PB0-PB7 using the helper function */
    	        write_led_byte(output_pattern);
    }
}

/* ---------- Helper: write an 8-bit pattern to PB0-PB7 ---------- */
static void write_led_byte(uint8_t pattern)
{
    uint32_t odr = GPIOB->ODR;
    odr &= ~(0xFFU);
    odr |= pattern;
    GPIOB->ODR = odr;
}
